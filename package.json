{
    "name": "kutt-extension",
    "version": "1.1.0",
    "description": "Browser extension for self-hosted Kutt URL shortener instances.",
    "license": "MIT",
    "repository": "https://github.com/HungNth/kutt-extension.git",
    "author": {
        "name": "HungNth",
        "email": "thienhungdev@gmail.com",
        "url": "https://github.com/HungNth/kutt-extension.git"
    },
    "engines": {
        "node": ">=22"
    },
    "type": "module",
    "scripts": {
        "dev:chrome": "cross-env TARGET_BROWSER=chrome vite build --config vite.config.ts --mode development --watch",
        "dev:firefox": "cross-env TARGET_BROWSER=firefox vite build --config vite.config.ts --mode development --watch",
        "build:chrome": "cross-env TARGET_BROWSER=chrome vite build --config vite.config.ts",
        "build:firefox": "cross-env TARGET_BROWSER=firefox vite build --config vite.config.ts",
        "build": "npm run build:chrome && npm run build:firefox",
        "test": "node --test",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix"
    },
    "keywords": [
        "url",
        "shortener",
        "browser",
        "extension",
        "addon",
        "kutt"
    ],
    "private": true,
    "dependencies": {
        "@abhijithvijayan/ts-utils": "^1.2.2",
        "advanced-css-reset": "^2.1.3",
        "axios": "^1.20.0",
        "clsx": "^2.1.1",
        "qrcode.react": "^4.2.0",
        "react": "^19.3.0",
        "react-copy-to-clipboard": "^5.1.1",
        "react-dom": "^19.3.0",
        "webextension-polyfill": "^0.12.0"
    },
    "devDependencies": {
        "@abhijithvijayan/eslint-config": "^3.0.1",
        "@abhijithvijayan/tsconfig": "^1.5.1",
        "@types/node": "^24.19.0",
        "@types/react": "^19.3.0",
        "@types/react-copy-to-clipboard": "^5.0.7",
        "@types/react-dom": "^19.3.0",
        "@types/webextension-polyfill": "^0.12.6",
        "@typescript-eslint/eslint-plugin": "^8.70.1",
        "@typescript-eslint/parser": "^8.70.1",
        "@vitejs/plugin-react": "^6.1.1",
        "autoprefixer": "^10.6.1",
        "cross-env": "^10.1.0",
        "eslint": "^9.39.5",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-import-x": "^4.17.1",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-n": "^18.3.0",
        "eslint-plugin-prettier": "^5.5.6",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^17.12.0",
        "postcss": "^8.5.28",
        "prettier": "^3.9.9",
        "sass": "^1.105.0",
        "typescript": "^5.9.3",
        "vite": "^8.3.1",
        "vite-plugin-checker": "^0.14.5",
        "vite-plugin-wext-manifest": "^1.2.2",
        "vite-plugin-zip-pack": "^1.2.4"
    }
}
